OCI_GENAI_API_KEY=replace-with-your-oracle-key
OCI_REGION=us-chicago-1
OCI_MODEL=meta.llama-3.3-70b-instruct
OCI_LIVE_QUIZ_MODEL=meta.llama-3.3-70b-instruct
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
STORAGE_DRIVER=file
# MySQL (OCI HeatWave) example:
DATABASE_URL=mysql://appuser:<password>@<db-host>:3306/<db-name>
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:<password>@<db-host>:5432/<db-name>
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
